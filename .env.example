# KaamSaathi Environment Configuration
# NOTE: The project works 100% out-of-the-box in MOCK MODE without any API keys.
# To connect to live Supabase and OpenAI, provide the keys below:

# Mock Mode (default: true)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Supabase (Optional for live DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API (Optional for cloud NLP parsing - built-in Urdu/Pashto/English keyword engine active by default)
OPENAI_API_KEY=sk-your-openai-api-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
